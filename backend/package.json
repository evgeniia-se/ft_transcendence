{
  "name": "ft-transcendence-backend",
  "version": "0.1.0",
  "private": true,
  "_owner": "Track 1 (Foundation, Auth, and API infrastructure) — package manifest; each src/modules/* subfolder has its own per-file ownership comments",
  "_description": "Node.js + TypeScript backend (Fastify, Prisma, Socket.IO) per docs/ft_transcendence_plan.md section 4 — replaces the former Go module (go.mod, removed)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "sh tests/run.sh",
    "test:types": "tsc -p tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@prisma/client": "^5.0.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.10",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "octokit": "^5.0.0",
    "prisma": "^5.0.0",
    "socket.io": "^4.0.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
